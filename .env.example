# TUGON environment template.
#
# Copy to web/.env.local for local development, or paste these names into the
# Vercel project settings. Every value the application renders comes from
# Supabase/PostgreSQL: there is no demo-mode switch and no sample dataset.
# When a required value is missing the workspace shows a configuration error
# instead of inventing data.

# --- Required: Supabase (drives every screen) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used for provisioning checks and background writes; never exposed
# to browser bundles or the Flutter client.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Absolute URL of this deployment. Used for auth redirects and API links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional integrations ---
# Push delivery is skipped when this is absent; notification rows are still
# written to the database, so in-app history always works.
FIREBASE_SERVER_KEY=

# The map panel reports "Map provider is not configured" until this is set.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# AI severity triage + auto-dispatch (server-only). Without it, keyword rules are used.
GEMINI_API_KEY=server-only-gemini-key
