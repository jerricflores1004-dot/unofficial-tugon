# Copy to web/.env.local. See the annotated template at the repository root.
# All application data is read from Supabase; there is no demo-mode fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
FIREBASE_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# AI severity triage + auto-dispatch (server-only). Without it, keyword rules are used.
GEMINI_API_KEY=
